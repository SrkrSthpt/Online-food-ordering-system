# ------------------------------------------------------------------
# Bitezy - environment template (copy to .env and fill in)
# ------------------------------------------------------------------

APP_NAME="Bitezy"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=
APP_TIMEZONE=Asia/Kathmandu
APP_LOCALE=en
APP_CURRENCY=NPR
APP_CURRENCY_SYMBOL=rs. 
DELIVERY_FEE=99

# ---- Database (local MySQL / MariaDB) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bitezy
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---- Session ----
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=bitezy_session
SESSION_SECURE_COOKIE=false

# ---- Security ----
HASH_COST=12
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_WINDOW=60

# ---- Payment (mock in dev; add live keys to go live) ----
PAYMENT_DEFAULT_METHOD=paypal
PAYMENT_MODE=sandbox
PAYMENT_MOCK=true
PAYMENT_WEBSITE_URL=http://localhost:8080
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox